# Copy to .env and fill in. Use hex so the values are safe inside database URLs.
#   openssl rand -hex 24   for each password
#   openssl rand -hex 32   for the session secret (at least 32 characters)

POSTGRES_PASSWORD=
TF_APP_PASSWORD=
TF_SESSION_SECRET=

# Set to true only behind an HTTPS reverse proxy. Leave false for http://127.0.0.1.
TF_SECURE_COOKIES=false
