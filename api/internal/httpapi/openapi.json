      "get": {
        "summary": "List projects in an organization workspace",
        "description": "API-token access is organization scoped. A read token can call GET operations; write scope is required for POST. Authorization and project access are checked on every request.",
        "operationId": "getapi_v1_workspaces__workspaceId__projects",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "ARCHIVED"
              ],
              "default": "ACTIVE"
            },
            "description": "Filters the workspace project list. Defaults to ACTIVE."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, or request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token"
          },
          "403": {
            "description": "Token scope or organization permission does not allow this operation"
          },
          "404": {
            "description": "Resource does not exist or is not visible to the caller"
          }
